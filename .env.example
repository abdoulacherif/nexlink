# Supabase — clé SERVICE ROLE (jamais côté client, contourne les RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret pour signer les sessions (génère une chaîne aléatoire longue, ex: openssl rand -hex 32)
JWT_SECRET=

# Gmail — utiliser un "mot de passe d'application" (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=